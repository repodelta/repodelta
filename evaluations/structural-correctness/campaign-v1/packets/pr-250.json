  "repository": "repodelta/repodelta",
  "schema_version": "structural_correctness_packet.v3",
  "subjects": [
    {
      "authored_statement": "A maintainer can invoke one documented command from a local checkout to push the current change and create a GitHub pull request under the App identity.",
      "subject_id": "R1",
      "subject_kind": "requirement"
    },
    {
      "authored_statement": "The command obtains a short-lived installation token from a locally held App private key and removes local token material when it exits.",
      "subject_id": "R2",
      "subject_kind": "requirement"
    },
    {
      "authored_statement": "The command can request one or more human reviewers while leaving approval to GitHub's protected-branch rules.",
      "subject_id": "R3",
      "subject_kind": "requirement"
    },
    {
      "authored_statement": "App, installation, repository, branch, base, title, body, and reviewer inputs are explicit or supplied by documented non-secret defaults.",
      "subject_id": "R4",
      "subject_kind": "requirement"
    },
    {
      "authored_statement": "Failures identify the failed stage without printing private keys, JWTs, installation tokens, or credential-bearing URLs.",
      "subject_id": "R5",
      "subject_kind": "requirement"
    },
    {
      "authored_statement": "Private keys and installation tokens never enter the repository, Git remotes, persistent Git configuration, process arguments, generated reports, or PR content.",
      "subject_id": "G1",
      "subject_kind": "guardrail"
    },
    {
      "authored_statement": "The tool does not approve or merge pull requests and does not bypass the main ruleset.",
      "subject_id": "G2",
      "subject_kind": "guardrail"
    },
    {
      "authored_statement": "The tool does not require organization, administration, secrets, workflow, or checks permissions.",
      "subject_id": "G3",
      "subject_kind": "guardrail"
    },
    {
      "authored_statement": "A private key readable by group or other users is rejected.",
      "subject_id": "G4",
      "subject_kind": "guardrail"
    },
    {
      "authored_statement": "Managing App managers or distributing private keys.",
      "subject_id": "G5",
      "subject_kind": "guardrail"
    },
    {
      "authored_statement": "Automatic approval, merge, release, or workflow modification.",
      "subject_id": "G6",
      "subject_kind": "guardrail"
    },
    {
      "authored_statement": "Governing how changes are implemented locally.",
      "subject_id": "G7",
      "subject_kind": "guardrail"
    },
    {
      "authored_statement": "RepoDelta's GitHub App could submit a change only through one-off local helper scripts. Those scripts were not a reviewed repository contract, other App managers could not reuse them, and credential cleanup depended on the operator.",
      "subject_id": "T1",
      "subject_kind": "transformation_claim"
    },
    {
      "authored_statement": "./tools/repodelta-bot submit is the canonical local App-submission path. It validates an owner-only private key, signs a short-lived App JWT, requests an installation token, supplies that token to Git through an owner-only temporary askpass file, pushes HEAD, creates the PR, and requests human reviewers. Temporary token material is removed on success and failure.",
      "subject_id": "T2",
      "subject_kind": "transformation_claim"
    },
    {
      "authored_statement": "The command does not approve or merge. GitHub's protected branch and human maintainer review remain the acceptance authority.",
      "subject_id": "T3",
      "subject_kind": "transformation_claim"
    },
    {
      "authored_statement": "Credential containment and cleanup are verified on success and failure.",
      "subject_id": "CC1",
      "subject_kind": "completion_condition"
    },
    {
      "authored_statement": "API failures remain bounded and do not echo JWT or token material.",
      "subject_id": "CC2",
      "subject_kind": "completion_condition"
    },
    {
      "authored_statement": "A real invocation creates this PR under the GitHub App identity, requests lucybai-dev, passes CI, and remains blocked for human approval.",
      "subject_id": "CC3",
      "subject_kind": "completion_condition"
    }
  ],
