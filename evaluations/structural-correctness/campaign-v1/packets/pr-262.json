  "repository": "repodelta/repodelta",
  "schema_version": "structural_correctness_packet.v3",
  "subjects": [
    {
      "authored_statement": "Selecting an R/G/T/CC subject in the structural investigation surface shows its authored statement, canonical assessment, observations, and source in the same inspector.",
      "subject_id": "R1",
      "subject_kind": "requirement"
    },
    {
      "authored_statement": "Assessment and evidence detail is progressively disclosed by default, while the assessment state and any contradiction, missing evidence, incomplete collection, or other exceptional condition remain visible without expansion.",
      "subject_id": "R2",
      "subject_kind": "requirement"
    },
    {
      "authored_statement": "A subject without structural mapping remains available and shows its authored statement and non-structural evidence; absence from the graph must not remove it from review.",
      "subject_id": "R3",
      "subject_kind": "requirement"
    },
    {
      "authored_statement": "The page has one canonical R/G/T/CC investigation entry rather than a second repeated Verification section.",
      "subject_id": "R4",
      "subject_kind": "requirement"
    },
    {
      "authored_statement": "Preserve verification_workspace, assessment authority, verification-matrix data, source identity, and coverage semantics.",
      "subject_id": "G1",
      "subject_kind": "guardrail"
    },
    {
      "authored_statement": "The structural graph may consume and focus canonical verification results but must not derive or re-decide assessment state.",
      "subject_id": "G2",
      "subject_kind": "guardrail"
    },
    {
      "authored_statement": "Do not classify absent structural mapping as absent authored or verification evidence.",
      "subject_id": "G3",
      "subject_kind": "guardrail"
    },
    {
      "authored_statement": "Assessment, observation, association, graph-membership, collection, or acceptance semantics.",
      "subject_id": "G4",
      "subject_kind": "guardrail"
    },
    {
      "authored_statement": "New evidence collection or LLM behavior.",
      "subject_id": "G5",
      "subject_kind": "guardrail"
    },
    {
      "authored_statement": "The structural surface rendered R/G/T/CC focus buttons and a short authored-copy row, while a second page-level Verification section rendered the canonical assessment, observations, source, and structural disposition. JavaScript synchronized both entry points. Subjects without structural facts survived only because the repeated Verification section remained present.",
      "subject_id": "T1",
      "subject_kind": "transformation_claim"
    },
    {
      "authored_statement": "Selecting R/G/T/CC now reveals one inspector inside the structural investigation surface. It shows the authored statement, source, canonical status, visible exception chips, and a collapsed Assessment & evidence detail containing canonical observations and reasons. The old authored-copy row, bottom Verification section, and cross-entry synchronization are removed.",
      "subject_id": "T2",
      "subject_kind": "transformation_claim"
    },
    {
      "authored_statement": "The focus controls are projected from the complete verification matrix even when the review graph has no nodes. Subjects without structural mapping therefore retain their authored statement, status, non-structural evidence, and explicit structural disposition.",
      "subject_id": "T3",
      "subject_kind": "transformation_claim"
    }
  ],
