{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PR 208 batch 001 isolated AI adjudicator output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch_id",
    "unresolved_ledger_sha256",
    "dispositions",
    "out_of_universe_review",
    "final_status"
  ],
  "properties": {
    "schema_version": {"const": "rg_semantic_ai_adjudication_output.v1"},
    "batch_id": {"const": "pr-208-batch-001"},
    "unresolved_ledger_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dispositions": {
      "type": "array",
      "minItems": 22,
      "maxItems": 22,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "disposition", "final_label", "note"],
        "properties": {
          "candidate_id": {"type": "string"},
          "disposition": {"enum": ["retain_proposer", "retain_verifier", "independent"]},
          "final_label": {
            "type": "object",
            "additionalProperties": false,
            "required": ["semantic_relation", "proofability", "proof_basis", "evidence_witnesses"],
            "properties": {
              "semantic_relation": {
                "enum": ["implements", "constrains", "removes", "directly_verifies", "contextual_support", "unrelated", "insufficient"]
              },
              "proofability": {"enum": ["direct_capable", "suggested_only", "not_applicable", "insufficient"]},
              "proof_basis": {"enum": ["explicit_authoring", "typed_predicate", "bounded_evidence", "deterministic_mapping", "heuristic", "model_suggestion", "none"]},
              "evidence_witnesses": {"type": "array", "items": {"type": "string"}}
            },
            "allOf": [
              {
                "if": {"properties": {"semantic_relation": {"enum": ["implements", "constrains", "removes", "directly_verifies"]}}},
                "then": {"properties": {"evidence_witnesses": {"minItems": 1}}}
              }
            ]
          },
          "note": {"type": "string", "minLength": 1}
        }
      }
    },
    "out_of_universe_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discovered_count", "note"],
      "properties": {
        "discovered_count": {"type": "integer", "minimum": 0},
        "note": {"type": "string"}
      }
    },
    "final_status": {"enum": ["all_resolved", "unresolved"]}
  }
}
